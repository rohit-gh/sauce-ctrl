{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SauceCtrl",
  "version": "0.1.0",
  "identifier": "dev.saucectrl.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A local Git GUI — Git, but pleasant.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun"],
    "resources": {
      "resources/app/": "app/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist"
    }
  }
}
